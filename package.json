{
  "name": "whiteboard-clock-desktop",
  "productName": "Whiteboard Clock",
  "version": "1.0.11",
  "description": "Whiteboard Clock para Windows: la misma app web, en su propia ventana.",
  "main": "src/main.js",
  "author": "Whiteboard Games",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "games.whiteboard.clock",
    "productName": "Whiteboard Clock",
    "protocols": [
      {
        "name": "Whiteboard Clock",
        "schemes": [
          "whiteboardclock"
        ]
      }
    ],
    "artifactName": "WhiteboardClock-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/*.png",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Whiteboard Clock",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Guillermo-Carbonell",
        "repo": "whiteboard-clock-desktop",
        "releaseType": "release"
      }
    ]
  }
}
